# Server-side values. Do not prefix model secrets with VITE_.
MODEL_API_KEY=
MODEL_NAME=
# OpenAI Responses API, or a compatible provider's /v1 base URL.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_FORMAT=responses
# Providers offering Chat Completions can use: MODEL_API_FORMAT=chat-completions

CHAT_HOST=127.0.0.1
CHAT_PORT=8787
# Required when CHAT_HOST listens beyond loopback.
PLAYER_TOKEN=
# Exact comma-separated website origins, needed for a separate frontend.
ALLOWED_ORIGINS=
# Set true when this server is behind your own HTTPS reverse proxy.
CHAT_HTTPS=false
# Optional public frontend configuration: full backend /api/chat URL.
# VITE_CHAT_API_URL=https://your-chat-service.example/api/chat
